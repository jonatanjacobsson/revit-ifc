<!--
  Optional override for CI / machines without Revit installed at the default path.
  Set env REVIT_API_PATH to a folder containing RevitAPI.dll, RevitAPIUI.dll, RevitAPIIFC.dll.
  Note: Directory.Build.props Reference Update cannot rewrite HintPaths defined later in
  .csproj files; use Directory.Build.targets for that. Projects also expect
  ..\..\..\API\2026 relative to Source\* (sibling of the repo root).
-->
<Project>
  <PropertyGroup>
    <RevitApiPath Condition="'$(REVIT_API_PATH)' != ''">$(REVIT_API_PATH)</RevitApiPath>
    <RevitApiPath Condition="'$(RevitApiPath)' == '' and Exists('$(MSBuildThisFileDirectory)API\2026\RevitAPI.dll')">$(MSBuildThisFileDirectory)API\2026</RevitApiPath>
    <RevitApiPath Condition="'$(RevitApiPath)' == '' and Exists('$(MSBuildThisFileDirectory)..\API\2026\RevitAPI.dll')">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\API\2026'))</RevitApiPath>
    <RevitApiPath Condition="'$(RevitApiPath)' == '' and Exists('C:\Program Files\Autodesk\Revit 2026\RevitAPI.dll')">C:\Program Files\Autodesk\Revit 2026</RevitApiPath>
  </PropertyGroup>
</Project>
